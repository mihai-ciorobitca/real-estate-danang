# Supabase: Project Settings > Database > Connection string.
# Use the transaction pooler URL for Vercel/serverless deployments.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:6543/postgres?sslmode=require

# Create a Blob store from the Vercel Storage dashboard.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Admin login at /admin/login. Use a long, unique password and secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public production URL (used by social metadata).
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
